# ── Atlas configuration ── copy to .env and fill in. NEVER commit .env.

# Telegram (from @BotFather) — the capture door + where the brief lands
TELEGRAM_BOT_TOKEN=
# Your own Telegram numeric chat id — Atlas only ever talks to you
OWNER_CHAT_ID=

# Groq (free tier) — Whisper transcription of voice notes + LLM understanding
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Kokoro TTS — already running on the box; the spoken morning brief
KOKORO_URL=http://localhost:8880
KOKORO_VOICE=af_heart

# Timing / locale
TIMEZONE=Africa/Cairo
BRIEF_HOUR=6
EVENING_CLOSE_HOUR=21

# Storage
ATLAS_DB_PATH=data/atlas.db
ATLAS_ARCHIVE_DIR=data/archive        # plain-markdown durable archive
